CREATE TABLE EnergySales (
    SaleID INT PRIMARY KEY,
    SaleDate DATE,
    Region VARCHAR(50),
    EnergyType VARCHAR(50),
    UnitsSold INT,
    PricePerUnit DECIMAL(10,2),
    CustomerType VARCHAR(30)
);

