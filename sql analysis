SELECT EnergyType, SUM(UnitsSold * PricePerUnit) AS TotalRevenue
FROM EnergySales
GROUP BY EnergyType;

SELECT Region, SUM(UnitsSold * PricePerUnit) AS TotalRevenue
FROM EnergySales
GROUP BY Region
HAVING SUM(UnitsSold * PricePerUnit) > (
    SELECT AVG(TotalRevenue)
    FROM (
        SELECT Region, SUM(UnitsSold * PricePerUnit) AS TotalRevenue
        FROM EnergySales
        GROUP BY Region
    ) R
);

SELECT EnergyType, SUM(UnitsSold) AS TotalUnits,
RANK() OVER (ORDER BY SUM(UnitsSold) DESC) AS EnergyRank
FROM EnergySales
GROUP BY EnergyType;

WITH R AS (
    SELECT *,
    UnitsSold * PricePerUnit AS Revenue,
    RANK() OVER (
        PARTITION BY Region
        ORDER BY UnitsSold * PricePerUnit DESC
    ) AS RN
    FROM EnergySales
)
SELECT SaleID, Region, EnergyType, Revenue
FROM R
WHERE RN = 1;

WITH E AS (
    SELECT EnergyType, SUM(UnitsSold) AS TotalUnits
    FROM EnergySales
    GROUP BY EnergyType
)
SELECT *
FROM E
WHERE TotalUnits > (
    SELECT AVG(TotalUnits)
    FROM E
);
